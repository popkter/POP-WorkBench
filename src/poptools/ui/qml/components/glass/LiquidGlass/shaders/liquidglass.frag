    vec3 lab = linearToOklab(toLinearApprox(vec3(col)));
    lab.x = lab.x + amount * 0.90;
    lab.yz = lab.yz * (1.0 + amount * 1.20);
    vec3 lifted = vec3(fromLinearApprox(clamp(oklabToLinear(lab), vec3(0.0), vec3(1.0))));
    return mix(additive, lifted, float(clamp(chroma, 0.0, 1.0)));
